# Rendered by scripts/release/package.sh; do not edit the generated copy by hand.
class Skillctl < Formula
  desc "Store Agent Skills once and symlink them into projects for Claude Code, Cursor and ZohoCode"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  url "@URL@"
  sha256 "@SHA256@"

  depends_on :macos

  def install
    bin.install "skillctl"
    generate_completions_from_executable(bin/"skillctl", "completions")
  end

  test do
    ENV["SKILLCTL_HOME"] = testpath/"skills"
    assert_match "registry schema", shell_output("#{bin}/skillctl --version")
    system bin/"skillctl", "init"
    assert_path_exists testpath/"skills/registry.yml"
    system bin/"skillctl", "new", "demo"
    system bin/"skillctl", "seal", "demo"
    assert_path_exists testpath/"skills/store/demo/0.1.0/meta.json"
  end
end
